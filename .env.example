# name/ISIN to match records to requested tickers.
CNMV_HR_IP_URL=https://www.cnmv.es/portal/informacion-privilegiada/RSS.asmx/GetNoticiasCNMV
CNMV_HR_OIR_URL=https://www.cnmv.es/portal/Otra-Informacion-Relevante/RSS.asmx/GetNoticiasCNMV
CNMV_HR_TIMEOUT_SECONDS=20
CNMV_HR_MAX_RETRIES=1
CNMV_HR_REQUESTS_PER_SECOND=1
# CNMV's certificate chain has been seen to fail intermittently from this
# network; keep verification ON (default true) and only opt out for this
# connector behind that quirk.
CNMV_HR_VERIFY_SSL=true

# ES second disclosure source: BME relevant-facts JSON (official BME API,
