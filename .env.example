# Required for live SEC requests.
# SEC asks automated clients to identify the application and a contact address.
SEC_USER_AGENT="InvestmentMonitor/0.1 your-email@example.com"

# Optional settings. The defaults shown are used when these are omitted.
SEC_TIMEOUT_SECONDS=10
SEC_MAX_RETRIES=2
SEC_REQUESTS_PER_SECOND=5
SEC_TICKER_CACHE_PATH=".cache/investment_monitor/company_tickers.json"
SEC_TICKER_CACHE_TTL_SECONDS=86400

# The web service runs one incremental collection per Eastern calendar day.
AUTO_DAILY_COLLECTION=true
DAILY_COLLECTION_HOUR_ET=6
DAILY_COLLECTION_LOOKBACK_DAYS=7

# A company added in the web UI receives this many days of immediate history.
INITIAL_BACKFILL_DAYS=365

# P1 real News source: Finnhub company news (https://finnhub.io).
# Free tier has documented rate limits; see Finnhub docs for plan quotas.
# When FINNHUB_API_KEY is empty, News stays Not connected and is skipped
# by collection without affecting SEC.
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1
FINNHUB_TIMEOUT_SECONDS=10
FINNHUB_MAX_RETRIES=2
FINNHUB_REQUESTS_PER_SECOND=1

# KR disclosures: OpenDART (https://opendart.fss.or.kr).
# Free API key; used for corp_code mapping and disclosure list.json queries.
# When DART_API_KEY is empty, the dart source stays Not connected and is
# skipped by collection without affecting SEC/News.
DART_API_KEY=
DART_BASE_URL=https://opendart.fss.or.kr/api
DART_TIMEOUT_SECONDS=10
DART_MAX_RETRIES=2
DART_REQUESTS_PER_SECOND=5
DART_CORP_CODE_CACHE_PATH=".cache/investment_monitor/dart_corp_codes.json"
DART_CORP_CODE_TTL_SECONDS=86400

# KR tradeable universe cache (breadth only; never written to the feed).
# Default source: dart_corpcode (uses DART_API_KEY above). data_krx is an
# optional key-free adapter but may be blocked for non-Korean IPs. The KRX
# OpenAPI adapter stays disabled because registration requires Korean
# identity; KRX_API_KEY is reserved for a future adapter.
KR_UNIVERSE_CACHE_PATH=".cache/investment_monitor/kr_universe.json"
KR_UNIVERSE_SOURCE=dart_corpcode
KRX_API_KEY=

# Free Korean news sources (market=kr only). Unofficial public page scrapes;
# may break without notice. No API keys required.
NAVER_NEWS_TIMEOUT_SECONDS=15
NAVER_NEWS_MAX_RETRIES=2
NAVER_NEWS_REQUESTS_PER_SECOND=2
# Naver paginates news list pages toward the request start_date; this caps
# the number of pages fetched per ticker (default 10).
NAVER_NEWS_MAX_PAGES=10
HANKYUNG_TIMEOUT_SECONDS=15
HANKYUNG_MAX_RETRIES=1
HANKYUNG_REQUESTS_PER_SECOND=2
THEBELL_TIMEOUT_SECONDS=15
THEBELL_MAX_RETRIES=1
THEBELL_REQUESTS_PER_SECOND=2

# Soft cross-source dedupe for the feed (display only; all rows are kept).
# Default on; the same switch also applies to UK and HK feed soft-dedupe
# (KR/UK/HK fold in the feed, never in the database).
KR_FEED_SOFT_DEDUPE=true

# UK: Companies House Public Data API (free).
# Apply at https://developer.company-information.service.gov.uk; ~600
# requests per 5 minutes. Provides statutory filings only, not RNS.
# Test application keys authenticate only against the sandbox base URL
# (https://api-sandbox.company-information.service.gov.uk); Live application
# keys use the default live API.
COMPANIES_HOUSE_API_KEY=
COMPANIES_HOUSE_BASE_URL=https://api.company-information.service.gov.uk
COMPANIES_HOUSE_TIMEOUT_SECONDS=15
COMPANIES_HOUSE_MAX_RETRIES=2
COMPANIES_HOUSE_REQUESTS_PER_SECOND=2
COMPANIES_HOUSE_NUMBER_CACHE_PATH=".cache/investment_monitor/companies_house_numbers.json"
# Filing history is paginated via start_index up to this cap (default 1000).
COMPANIES_HOUSE_FILING_HISTORY_MAX_ITEMS=1000
# One-time legacy mapping scrub marker; confirmations stay trusted afterwards.
# Verified/confirmed mappings are NOT subject to the old 24h soft-cache
# expiry; the trusted number cache persists until explicitly removed.
CH_MAPPING_LEGACY_SCRUB_SENTINEL=".cache/investment_monitor/ch_mapping_legacy_scrubbed"

# UK RNS-class public mirror (Investegate). Key-free page scrape; may break
# without notice. Not an official LSEG RNS feed.
INVESTEGATE_BASE_URL=https://www.investegate.co.uk
INVESTEGATE_TIMEOUT_SECONDS=20
INVESTEGATE_MAX_RETRIES=1
INVESTEGATE_REQUESTS_PER_SECOND=1

# UK tradeable universe cache (breadth only; never written to the feed).
# Source: FCA FIRDS FULINS (key-free). FIRDS has no ticker mnemonics, so the
# cache is ISIN-keyed with a small seed giving tickers for common blue chips.
# The full daily set is large; UK_UNIVERSE_MAX_PARTS limits downloads for
# incremental validation.
UK_UNIVERSE_CACHE_PATH=".cache/investment_monitor/uk_universe.json"
UK_UNIVERSE_SOURCE=firds
UK_UNIVERSE_MAX_PARTS=
# Enrich UK equities with tickers via the free OpenFIGI mapping API
# (anonymous, key-free at low volume; best-effort, failure keeps old cache).
UK_UNIVERSE_ENRICH_TICKERS=true
UK_UNIVERSE_OPENFIGI_URL=https://api.openfigi.com/v3/mapping

# HK tradeable universe cache (breadth only; never written to the feed).
# Source: HKEXnews active/inactive stock lists (key-free, unofficial JSON,
# may change without notice). Not an IBKR-complete universe.
HK_UNIVERSE_CACHE_PATH=".cache/investment_monitor/hk_universe.json"

# TW tradeable universe cache (breadth only; never written to the feed).
# Sources: TWSE listed (t187ap03_L) and TPEx OTC (mopsfin_t187ap03_O) open
# company directories. Emerging (興櫃) has no stable free JSON; set
# TW_UNIVERSE_EMERGING_URL to an optional TPEx-shaped JSON source.
# TWSE's certificate fails strict Python TLS (missing SKI); keep verification
# on unless you explicitly opt out.
TW_UNIVERSE_CACHE_PATH=".cache/investment_monitor/tw_universe.json"
TW_UNIVERSE_VERIFY_SSL=true
TW_UNIVERSE_EMERGING_URL=

# CA tradeable universe cache (breadth only; never written to the feed).
# Sources: TSX and TSXV company directories via key-free official TMX JSON
# (/json/company-directory/search/tsx/^ and .../tsxv/^). CSE (TLS handshake
# fails from the current network) and NEO (Cloudflare 522 origin timeout)
# are not wired. Board URLs can be overridden per environment.
CA_UNIVERSE_CACHE_PATH=".cache/investment_monitor/ca_universe.json"
CA_UNIVERSE_VERIFY_SSL=true
CA_TSX_UNIVERSE_URL=
CA_TSXV_UNIVERSE_URL=

# CA news: Yahoo Finance CA RSS and Google News CA RSS (both key-free,
# may be loosely related and may break without notice).
YAHOO_CA_NEWS_URL=https://feeds.finance.yahoo.com/rss/2.0/headline
YAHOO_CA_NEWS_TIMEOUT_SECONDS=20
YAHOO_CA_NEWS_MAX_RETRIES=1
YAHOO_CA_NEWS_REQUESTS_PER_SECOND=1
GOOGLE_CA_NEWS_URL=https://news.google.com/rss/search
GOOGLE_CA_NEWS_TIMEOUT_SECONDS=20
GOOGLE_CA_NEWS_MAX_RETRIES=1
GOOGLE_CA_NEWS_REQUESTS_PER_SECOND=1

# AU disclosure: ASX company announcements via the ASX site research API
# (key-free; undocumented internal JSON, may change without notice; returns
# only the latest 5 announcements per company; no deep document link).
ASX_ANNOUNCEMENTS_URL=https://asx.api.markitdigital.com/asx-research/1.0/companies
ASX_ANNOUNCEMENTS_TIMEOUT_SECONDS=20
ASX_ANNOUNCEMENTS_MAX_RETRIES=1
ASX_ANNOUNCEMENTS_REQUESTS_PER_SECOND=1

# AU tradeable universe cache (breadth only; never written to the feed).
# Source: ASX site research API company directory (key-free JSON,
# ~1840 listed companies live 2026-08-08); same endpoint family as
# ASX_ANNOUNCEMENTS_URL. Not an IBKR-complete universe.
AU_UNIVERSE_CACHE_PATH=".cache/investment_monitor/au_universe.json"
AU_UNIVERSE_VERIFY_SSL=true
AU_UNIVERSE_DIRECTORY_URL=https://asx.api.markitdigital.com/asx-research/1.0/companies/directory

# AU news: Yahoo Finance AU RSS and Google News AU RSS (both key-free,
# may be loosely related and may break without notice).
YAHOO_AU_NEWS_URL=https://feeds.finance.yahoo.com/rss/2.0/headline
YAHOO_AU_NEWS_TIMEOUT_SECONDS=20
YAHOO_AU_NEWS_MAX_RETRIES=1
YAHOO_AU_NEWS_REQUESTS_PER_SECOND=1
GOOGLE_AU_NEWS_URL=https://news.google.com/rss/search
GOOGLE_AU_NEWS_TIMEOUT_SECONDS=20
GOOGLE_AU_NEWS_MAX_RETRIES=1
GOOGLE_AU_NEWS_REQUESTS_PER_SECOND=1

# UK news: Yahoo Finance UK RSS mirror (key-free). May break without notice.
YAHOO_UK_NEWS_URL=https://feeds.finance.yahoo.com/rss/2.0/headline
YAHOO_UK_NEWS_TIMEOUT_SECONDS=20
YAHOO_UK_NEWS_MAX_RETRIES=1
YAHOO_UK_NEWS_REQUESTS_PER_SECOND=1
