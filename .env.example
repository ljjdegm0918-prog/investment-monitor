EUX_UNIVERSE_VERIFY_SSL=true

# Research cards (evidence-backed AI summaries). Disabled by default.
# Generating a card sends the selected company's stored public evidence to
# the configured OpenAI-compatible model provider. This is research
# assistance only and is not investment advice. The API key is read only from
# the environment and is never stored in SQLite, returned by an API, or logged.
RESEARCH_AI_ENABLED=false
RESEARCH_AI_BASE_URL=https://api.deepseek.com
RESEARCH_AI_MODEL=deepseek-chat
RESEARCH_AI_API_KEY=
RESEARCH_AI_REQUEST_TIMEOUT_SECONDS=60
# Research evidence comes from the exact date range and list the user selects
# on the Research page (shared with the Daily report); there is no separate
# lookback window.
# Research uses ALL eligible evidence in the selected date range; there is no
# count-based truncation. If the full range cannot be sent safely, generation
# is refused (research_range_too_large) instead of silently dropping items.
RESEARCH_MIN_EVIDENCE_ITEMS=3

# Scheme the browser sees at the reverse-proxy entry point ("http" for local
# dev, "https" for production behind an HTTPS reverse proxy). This is used for
# same-origin CSRF checks and must reflect the external protocol, not the
# internal listen protocol. Client-supplied X-Forwarded-Proto is never trusted.
WEB_EXTERNAL_SCHEME=http

# Optional bearer token that gates every /api/* request.
# - Empty/unset: local-dev compatibility, no auth is enforced.
# - Set to a strong random value in production: every API request must send
#   "Authorization: Bearer <WEB_AUTH_TOKEN>". The browser stores the token in
#   localStorage under "im_web_auth_token" (never in the server database):
#   localStorage.setItem("im_web_auth_token", "<token>")
# Never commit a real token. Rotate it if it leaks.
WEB_AUTH_TOKEN=

# Username/password login (session cookie im_session).
# The first administrator is created from INITIAL_ADMIN_USERNAME /
# INITIAL_ADMIN_PASSWORD when the database has no loginable account yet.
# Leave both empty on a fresh instance to keep the legacy no-login mode;
# the login wall activates as soon as any account exists (initial admin or
# attach-legacy-login). Never commit real credentials.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
