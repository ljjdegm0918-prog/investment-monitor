# Required for live SEC requests.
# SEC asks automated clients to identify the application and a contact address.
SEC_USER_AGENT="InvestmentMonitor/0.1 your-email@example.com"

# Optional settings. The defaults shown are used when these are omitted.
SEC_TIMEOUT_SECONDS=10
SEC_MAX_RETRIES=2
SEC_REQUESTS_PER_SECOND=5
SEC_TICKER_CACHE_PATH=".cache/investment_monitor/company_tickers.json"
SEC_TICKER_CACHE_TTL_SECONDS=86400

# The web service runs one incremental collection per Eastern calendar day.
AUTO_DAILY_COLLECTION=true
DAILY_COLLECTION_HOUR_ET=6
DAILY_COLLECTION_LOOKBACK_DAYS=7

# A company added in the web UI receives this many days of immediate history.
INITIAL_BACKFILL_DAYS=365

# P1 real News source: Finnhub company news (https://finnhub.io).
# Free tier has documented rate limits; see Finnhub docs for plan quotas.
# When FINNHUB_API_KEY is empty, News stays Not connected and is skipped
# by collection without affecting SEC.
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1
FINNHUB_TIMEOUT_SECONDS=10
FINNHUB_MAX_RETRIES=2
FINNHUB_REQUESTS_PER_SECOND=1

# KR disclosures: OpenDART (https://opendart.fss.or.kr).
# Free API key; used for corp_code mapping and disclosure list.json queries.
# When DART_API_KEY is empty, the dart source stays Not connected and is
# skipped by collection without affecting SEC/News.
DART_API_KEY=
DART_BASE_URL=https://opendart.fss.or.kr/api
DART_TIMEOUT_SECONDS=10
DART_MAX_RETRIES=2
DART_REQUESTS_PER_SECOND=5
DART_CORP_CODE_CACHE_PATH=".cache/investment_monitor/dart_corp_codes.json"
DART_CORP_CODE_TTL_SECONDS=86400

# KR tradeable universe cache (breadth only; never written to the feed).
# Default source: dart_corpcode (uses DART_API_KEY above). data_krx is an
# optional key-free adapter but may be blocked for non-Korean IPs. The KRX
# OpenAPI adapter stays disabled because registration requires Korean
# identity; KRX_API_KEY is reserved for a future adapter.
KR_UNIVERSE_CACHE_PATH=".cache/investment_monitor/kr_universe.json"
KR_UNIVERSE_SOURCE=dart_corpcode
KRX_API_KEY=

# Free Korean news sources (market=kr only). Unofficial public page scrapes;
# may break without notice. No API keys required.
NAVER_NEWS_TIMEOUT_SECONDS=15
NAVER_NEWS_MAX_RETRIES=2
NAVER_NEWS_REQUESTS_PER_SECOND=2
HANKYUNG_TIMEOUT_SECONDS=15
HANKYUNG_MAX_RETRIES=1
HANKYUNG_REQUESTS_PER_SECOND=2
THEBELL_TIMEOUT_SECONDS=15
THEBELL_MAX_RETRIES=1
THEBELL_REQUESTS_PER_SECOND=2

# Soft cross-source dedupe for the feed (display only; all rows are kept).
KR_FEED_SOFT_DEDUPE=true

# UK: Companies House Public Data API (free).
# Apply at https://developer.company-information.service.gov.uk; ~600
# requests per 5 minutes. Provides statutory filings only, not RNS.
# Test application keys authenticate only against the sandbox base URL
# (https://api-sandbox.company-information.service.gov.uk); Live application
# keys use the default live API.
COMPANIES_HOUSE_API_KEY=
COMPANIES_HOUSE_BASE_URL=https://api.company-information.service.gov.uk
COMPANIES_HOUSE_TIMEOUT_SECONDS=15
COMPANIES_HOUSE_MAX_RETRIES=2
COMPANIES_HOUSE_REQUESTS_PER_SECOND=2
COMPANIES_HOUSE_NUMBER_CACHE_PATH=".cache/investment_monitor/companies_house_numbers.json"

# UK RNS-class public mirror (Investegate). Key-free page scrape; may break
# without notice. Not an official LSEG RNS feed.
INVESTEGATE_BASE_URL=https://www.investegate.co.uk
INVESTEGATE_TIMEOUT_SECONDS=20
INVESTEGATE_MAX_RETRIES=1
INVESTEGATE_REQUESTS_PER_SECOND=1

# UK tradeable universe cache (breadth only; never written to the feed).
# Source: FCA FIRDS FULINS (key-free). FIRDS has no ticker mnemonics, so the
# cache is ISIN-keyed with a small seed giving tickers for common blue chips.
# The full daily set is large; UK_UNIVERSE_MAX_PARTS limits downloads for
# incremental validation.
UK_UNIVERSE_CACHE_PATH=".cache/investment_monitor/uk_universe.json"
UK_UNIVERSE_SOURCE=firds
UK_UNIVERSE_MAX_PARTS=

# UK news: Yahoo Finance UK RSS mirror (key-free). May break without notice.
YAHOO_UK_NEWS_URL=https://feeds.finance.yahoo.com/rss/2.0/headline
YAHOO_UK_NEWS_TIMEOUT_SECONDS=20
YAHOO_UK_NEWS_MAX_RETRIES=1
YAHOO_UK_NEWS_REQUESTS_PER_SECOND=1

# Optional TDnet free public-page connector. Keep it disabled in settings.yaml
# until you have reviewed robots guidance and JPX public-page access terms and
# obtained any permission required for automated access.
TDNET_USER_AGENT="InvestmentMonitor/0.1 your-email@example.com"
TDNET_PUBLIC_PAGE_PERMISSION_CONFIRMED=false
TDNET_YANOSHIN_LIMIT=2000
TDNET_YANOSHIN_CROSSCHECK_ENABLED=false

# Official EDINET API v2. Register at:
# https://api.edinet-fsa.go.jp/api/auth/index.aspx?mode=1
EDINET_API_KEY=
EDINET_BASE_URL=https://api.edinet-fsa.go.jp/api/v2
EDINET_DATABASE_PATH=data/investment_monitor.sqlite3
EDINET_DOWNLOAD_ROOT=data/downloads
EDINET_CACHE_TTL_SECONDS=60
EDINET_TIMEOUT_SECONDS=15
EDINET_MAX_RETRIES=3
EDINET_REQUESTS_PER_SECOND=2

# NL disclosure: EQS News JSON by Dutch ISIN (key-free; unofficial WP API,
# may change; partial Dutch-issuer coverage; NOT an AFM official feed).
EQS_NL_URL=https://www.eqs-news.com/wp-json/eqsnews/v1
EQS_NL_PUBLIC_BASE=https://www.eqs-news.com
EQS_NL_TIMEOUT_SECONDS=20
EQS_NL_MAX_RETRIES=1
EQS_NL_REQUESTS_PER_SECOND=1

# IT disclosure: EQS News JSON by Italian ISIN (key-free; unofficial WP API,
# may change; partial Italian-issuer coverage; NOT a Consob official feed).
EQS_IT_URL=https://www.eqs-news.com/wp-json/eqsnews/v1
EQS_IT_PUBLIC_BASE=https://www.eqs-news.com
EQS_IT_TIMEOUT_SECONDS=20
EQS_IT_MAX_RETRIES=1
EQS_IT_REQUESTS_PER_SECOND=1

# IT tradeable universe cache (breadth only; never written to the feed).
# Source: Euronext live all-stocks CSV, Milan segment rows (key-free;
# ~447 Milan rows live 2026-08-10: Euronext Milan + Euronext Growth Milan).
IT_UNIVERSE_CACHE_PATH=".cache/investment_monitor/it_universe.json"
IT_UNIVERSE_VERIFY_SSL=true
IT_UNIVERSE_DIRECTORY_URL=https://live.euronext.com/en/pd_es/data/stocks/download?mics=dm_all_stock

# IT news: Yahoo Finance IT RSS and Google News IT RSS (both key-free,
# may be loosely related and may break without notice).
YAHOO_IT_NEWS_URL=https://feeds.finance.yahoo.com/rss/2.0/headline
YAHOO_IT_NEWS_TIMEOUT_SECONDS=20
YAHOO_IT_NEWS_MAX_RETRIES=1
YAHOO_IT_NEWS_REQUESTS_PER_SECOND=1
GOOGLE_IT_NEWS_URL=https://news.google.com/rss/search
GOOGLE_IT_NEWS_TIMEOUT_SECONDS=20
GOOGLE_IT_NEWS_MAX_RETRIES=1
GOOGLE_IT_NEWS_REQUESTS_PER_SECOND=1

# NL tradeable universe cache (breadth only; never written to the feed).
# Source: Euronext live all-stocks CSV, Amsterdam segment rows (key-free;
# ~135 Amsterdam rows live 2026-08-10 including multi-venue cross-listings).
NL_UNIVERSE_CACHE_PATH=".cache/investment_monitor/nl_universe.json"
NL_UNIVERSE_VERIFY_SSL=true
NL_UNIVERSE_DIRECTORY_URL=https://live.euronext.com/en/pd_es/data/stocks/download?mics=dm_all_stock

# NL news: Yahoo Finance NL RSS and Google News NL RSS (both key-free,
# may be loosely related and may break without notice).
YAHOO_NL_NEWS_URL=https://feeds.finance.yahoo.com/rss/2.0/headline
YAHOO_NL_NEWS_TIMEOUT_SECONDS=20
YAHOO_NL_NEWS_MAX_RETRIES=1
YAHOO_NL_NEWS_REQUESTS_PER_SECOND=1
GOOGLE_NL_NEWS_URL=https://news.google.com/rss/search
GOOGLE_NL_NEWS_TIMEOUT_SECONDS=20
GOOGLE_NL_NEWS_MAX_RETRIES=1
GOOGLE_NL_NEWS_REQUESTS_PER_SECOND=1

# ES disclosures: CNMV official relevant-information RSS (key-free; official
# CNMV feed, not a paid MOPS-style push). Two feeds are fetched: inside
# information (IP) and other relevant information (OIR). Needs universe
# name/ISIN to match records to requested tickers.
CNMV_HR_IP_URL=https://www.cnmv.es/portal/informacion-privilegiada/RSS.asmx/GetNoticiasCNMV
CNMV_HR_OIR_URL=https://www.cnmv.es/portal/Otra-Informacion-Relevante/RSS.asmx/GetNoticiasCNMV
CNMV_HR_TIMEOUT_SECONDS=20
CNMV_HR_MAX_RETRIES=1
CNMV_HR_REQUESTS_PER_SECOND=1
# CNMV's certificate chain has been seen to fail intermittently from this
# network; keep verification ON (default true) and only opt out for this
# connector behind that quirk.
CNMV_HR_VERIFY_SSL=true

# ES second disclosure source: BME relevant-facts JSON (official BME API,
# key-free, same family as the universe; needs the ES universe company key).
# The API clamps the requested range to at most ~31 calendar days.
BME_RELEVANT_FACTS_URL=https://apiweb.bolsasymercados.es/Market/v1/EQ/RelevantFacts
BME_RELEVANT_FACTS_TIMEOUT_SECONDS=20
BME_RELEVANT_FACTS_MAX_RETRIES=1
BME_RELEVANT_FACTS_REQUESTS_PER_SECOND=1

# ES tradeable universe cache (breadth only; never written to the feed).
# Source: official BME equity API (key-free; SIBE/Floor/Latibex + MTF
# BMEGrowth/BMEScaleUp equities; funds excluded). Tickers are enriched per
# ISIN from ShareDetailsInfo (rate-limited; reuses cached tickers).
ES_UNIVERSE_CACHE_PATH=".cache/investment_monitor/es_universe.json"
ES_UNIVERSE_VERIFY_SSL=true
ES_UNIVERSE_DIRECTORY_URL=https://apiweb.bolsasymercados.es/Market/v1/EQ/ListedCompanies
ES_UNIVERSE_DETAIL_URL=https://apiweb.bolsasymercados.es/Market/v1/EQ/ShareDetailsInfo
ES_UNIVERSE_REQUESTS_PER_SECOND=1
ES_UNIVERSE_ENRICH_TICKERS=true

# ES news: Yahoo Finance ES RSS and Google News ES RSS (both key-free,
# may be loosely related and may break without notice).
YAHOO_ES_NEWS_URL=https://feeds.finance.yahoo.com/rss/2.0/headline
YAHOO_ES_NEWS_TIMEOUT_SECONDS=20
YAHOO_ES_NEWS_MAX_RETRIES=1
YAHOO_ES_NEWS_REQUESTS_PER_SECOND=1
GOOGLE_ES_NEWS_URL=https://news.google.com/rss/search
GOOGLE_ES_NEWS_TIMEOUT_SECONDS=20
GOOGLE_ES_NEWS_MAX_RETRIES=1
GOOGLE_ES_NEWS_REQUESTS_PER_SECOND=1

# SG tradeable universe cache (breadth only; never written to the feed).
# Boundary stub (SG-2 spike B2): no stable key-free SGX directory is wired,
# so refresh_sg_universe() raises SgUniverseError. The cache path is
# reserved for a future SGX/regulator directory slice.
SG_UNIVERSE_CACHE_PATH=".cache/investment_monitor/sg_universe.json"

# SG news: Yahoo Finance SG RSS and Google News SG RSS (both key-free,
# may be loosely related and may break without notice).
YAHOO_SG_NEWS_URL=https://feeds.finance.yahoo.com/rss/2.0/headline
YAHOO_SG_NEWS_TIMEOUT_SECONDS=20
YAHOO_SG_NEWS_MAX_RETRIES=1
YAHOO_SG_NEWS_REQUESTS_PER_SECOND=1
GOOGLE_SG_NEWS_URL=https://news.google.com/rss/search
GOOGLE_SG_NEWS_TIMEOUT_SECONDS=20
GOOGLE_SG_NEWS_MAX_RETRIES=1
GOOGLE_SG_NEWS_REQUESTS_PER_SECOND=1

# CH disclosures: EQS News JSON by Swiss ISIN (key-free; unofficial public
# WordPress API; partial Swiss coverage - Roche/UBS return records, some
# other ISINs return empty lists; NOT a SIX/FINMA official feed). Needs ISIN
# from the CH universe cache or a typed Swiss ISIN.
EQS_CH_URL=https://www.eqs-news.com/wp-json/eqsnews/v1
EQS_CH_PUBLIC_BASE=https://www.eqs-news.com
EQS_CH_TIMEOUT_SECONDS=20
EQS_CH_MAX_RETRIES=1
EQS_CH_REQUESTS_PER_SECOND=1

# CH tradeable universe cache (breadth only; never written to the feed).
# Boundary stub (CH-2 spike B2): no stable key-free SIX directory is wired,
# so refresh_ch_universe() raises ChUniverseError. The cache path is
# reserved for a future SIX/regulator directory slice.
CH_UNIVERSE_CACHE_PATH=".cache/investment_monitor/ch_universe.json"

# CH news: Yahoo Finance CH RSS and Google News CH RSS (both key-free,
# may be loosely related and may break without notice).
YAHOO_CH_NEWS_URL=https://feeds.finance.yahoo.com/rss/2.0/headline
YAHOO_CH_NEWS_TIMEOUT_SECONDS=20
YAHOO_CH_NEWS_MAX_RETRIES=1
YAHOO_CH_NEWS_REQUESTS_PER_SECOND=1
GOOGLE_CH_NEWS_URL=https://news.google.com/rss/search
GOOGLE_CH_NEWS_TIMEOUT_SECONDS=20
GOOGLE_CH_NEWS_MAX_RETRIES=1
GOOGLE_CH_NEWS_REQUESTS_PER_SECOND=1

# PL news: Yahoo Finance PL RSS and Google News PL RSS (both key-free,
# may be loosely related and may break without notice). Yahoo uses the
# .WA request-time suffix; stored tickers stay canonical root symbols.
YAHOO_PL_NEWS_URL=https://feeds.finance.yahoo.com/rss/2.0/headline
YAHOO_PL_NEWS_TIMEOUT_SECONDS=20
YAHOO_PL_NEWS_MAX_RETRIES=1
YAHOO_PL_NEWS_REQUESTS_PER_SECOND=1
GOOGLE_PL_NEWS_URL=https://news.google.com/rss/search
GOOGLE_PL_NEWS_TIMEOUT_SECONDS=20
GOOGLE_PL_NEWS_MAX_RETRIES=1
GOOGLE_PL_NEWS_REQUESTS_PER_SECOND=1

# SE news: Yahoo Finance SE RSS and Google News SE RSS (both key-free,
# may be loosely related and may break without notice). Yahoo uses the
# .ST request-time suffix; stored tickers stay canonical root symbols.
YAHOO_SE_NEWS_URL=https://feeds.finance.yahoo.com/rss/2.0/headline
YAHOO_SE_NEWS_TIMEOUT_SECONDS=20
YAHOO_SE_NEWS_MAX_RETRIES=1
YAHOO_SE_NEWS_REQUESTS_PER_SECOND=1
GOOGLE_SE_NEWS_URL=https://news.google.com/rss/search
GOOGLE_SE_NEWS_TIMEOUT_SECONDS=20
GOOGLE_SE_NEWS_MAX_RETRIES=1
GOOGLE_SE_NEWS_REQUESTS_PER_SECOND=1

# .AQ request-time suffix; stored tickers stay canonical root symbols.
YAHOO_AQ_NEWS_URL=https://feeds.finance.yahoo.com/rss/2.0/headline
YAHOO_AQ_NEWS_TIMEOUT_SECONDS=20
YAHOO_AQ_NEWS_MAX_RETRIES=1
YAHOO_AQ_NEWS_REQUESTS_PER_SECOND=1
GOOGLE_AQ_NEWS_URL=https://news.google.com/rss/search
GOOGLE_AQ_NEWS_TIMEOUT_SECONDS=20
GOOGLE_AQ_NEWS_MAX_RETRIES=1
GOOGLE_AQ_NEWS_REQUESTS_PER_SECOND=1

# PL disclosure: official GPW ESPI/EBI reports page (key-free HTML list,
# ISIN-filterable; live verified 2026-08-10). Needs a Polish ISIN from the
# PL universe cache. espi.gpw.pl remains unreachable from this network;
# GPW paid data products are not used.
GPW_ESPI_URL=https://www.gpw.pl/komunikaty
GPW_ESPI_TIMEOUT_SECONDS=20
GPW_ESPI_MAX_RETRIES=1
GPW_ESPI_REQUESTS_PER_SECOND=1

# PL tradeable universe cache (breadth only; never written to the feed).
# Source: official GPW HTML directories (key-free). GPW Main Market
# (/spolki?limit=403, ~403 companies) and NewConnect
# (/spolki?limit=403 on newconnect.pl, ~349 companies), both live verified
# 2026-08-10. The old lista-spolek* URLs 404 and ajaxindex.php rejects
# non-browser clients, so only the public GET pages are used.
PL_UNIVERSE_CACHE_PATH=".cache/investment_monitor/pl_universe.json"
PL_UNIVERSE_VERIFY_SSL=true
PL_UNIVERSE_DIRECTORY_URL=https://www.gpw.pl/spolki?limit=403
PL_UNIVERSE_NEWCONNECT_URL=https://newconnect.pl/spolki?limit=403

# SE tradeable universe cache (breadth only; never written to the feed).
# Boundary stub (SE-2 spike B2): no stable key-free Nasdaq Stockholm
# directory is wired, so refresh_se_universe() raises SeUniverseError. The
# cache path is reserved for a future Nasdaq/FI directory slice.
SE_UNIVERSE_CACHE_PATH=".cache/investment_monitor/se_universe.json"

# AQ universe (AQ-2): unofficial ticker.app AQSE mirror (partial; ~79
# instruments live 2026-08-10). The official Aquis directory is behind a
# Vercel bot challenge for non-browser clients and is not wired.
AQ_UNIVERSE_CACHE_PATH=".cache/investment_monitor/aq_universe.json"
AQ_UNIVERSE_DIRECTORY_URL=https://www.ticker.app/aqse
AQ_UNIVERSE_VERIFY_SSL=true

# CXE universe (AEE-2): official Cboe Europe Symbol Data CSVs for the two
# Cboe Europe equities order books (CXE/BXE). CSV has no ISIN column.
CXE_UNIVERSE_CACHE_PATH=".cache/investment_monitor/cxe_universe.json"
CXE_UNIVERSE_CXE_URL=https://www.cboe.com/europe/equities/market_statistics/symbol_data/csv/?mkt=cxe
CXE_UNIVERSE_BXE_URL=https://www.cboe.com/europe/equities/market_statistics/symbol_data/csv/?mkt=bxe
CXE_UNIVERSE_VERIFY_SSL=true
